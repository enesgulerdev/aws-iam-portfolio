# Local Terraform directories
*.terraform*
.terraform.lock.h5

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash[0-9]*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include DS_Store or thumbs for cleaner workspace
.DS_Store
Thumbs.db